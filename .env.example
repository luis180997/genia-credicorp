# ==============================================
# Genia AI Agent - Configuracion de Entorno
# Copia este archivo a .env y completa los valores
# ==============================================

# ======================
# Toggles de Servicios Azure
# Cambiar a false para usar alternativas locales
# ======================
USE_AZURE_OPENAI=true
USE_AZURE_BLOB=true
USE_AZURE_COSMOS=true
USE_AZURE_SEARCH=true

# ======================
# Configuracion OpenAI (Alternativa local)
# Descomentar si no usas Azure OpenAI
# ======================
# OPENAI_API_KEY=tu-api-key-de-openai
# OPENAI_MODEL=gpt-4o-mini

# ======================
# Azure OpenAI
# ======================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
EMBEDDING_MODEL=text-embedding-3-small

# ======================
# Azure Blob Storage
# ======================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=genia-documents

# ======================
# Azure Cosmos DB
# ======================
AZURE_COSMOS_ENDPOINT=https://tu-recurso.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=genia
AZURE_COSMOS_CONTAINER=conversations
AZURE_COSMOS_DOCUMENTS_CONTAINER=documents

# ======================
# Azure AI Search
# ======================
AZURE_SEARCH_ENDPOINT=https://tu-recurso.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=genia-documents

# ======================
# Azure AI Search - Modo Indexador
# Cuando es true, Azure procesa documentos automaticamente
# desde Blob Storage usando el Indexador configurado
# ======================
USE_AZURE_SEARCH_INDEXER_MODE=true
AZURE_SEARCH_INDEXER_NAME=tu-indexador-name
AZURE_SEARCH_VECTOR_FIELD=text_vector
AZURE_SEARCH_CONTENT_FIELD=chunk
AZURE_SEARCH_TITLE_FIELD=title

# ======================
# Rutas de almacenamiento local
# ======================
LOCAL_STORAGE_PATH=./data/documents
LOCAL_VECTOR_STORE_PATH=./data/vector_store

# ======================
# Parametros del Agente
# ======================
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=1500
MEMORY_WINDOW_K=10

# ======================
# Parametros RAG
# Solo aplican en modo PUSH (USE_AZURE_SEARCH_INDEXER_MODE=false)
# En modo Indexador, Azure hace el chunking automaticamente
# ======================
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
SEARCH_K_RETRIEVAL=5

# ======================
# Configuracion de la Aplicacion
# ======================
APP_NAME=Genia
APP_VERSION=1.0.0
DEBUG=true
